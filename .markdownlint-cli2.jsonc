{
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": { "allowed_elements": [] }
  },
  "globs": ["**/*.md"],
  "gitignore": true,
  // AnalyzerReleases files use Roslyn's required release tracking format.
  "ignores": [".git/**", "**/node_modules/**", "artifacts/**", "**/AnalyzerReleases.*.md"]
}
