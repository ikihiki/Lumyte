<Project>
  <Import Project="ParleyBuild.targets" />
  <PropertyGroup>
    <LumyteBuildParleyNative Condition="'$(LumyteBuildParleyNative)' == ''">true</LumyteBuildParleyNative>
    <LumyteParleyNativeToolchain Condition="'$(LumyteParleyNativeToolchain)' == ''">1.99.1</LumyteParleyNativeToolchain>
    <LumyteParleyNativeOutput Condition="'$(LumyteParleyNativeOutput)' == ''">$(_LumyteParleyRepositoryRoot)artifacts/text-parley/native</LumyteParleyNativeOutput>
    <LumyteParleyNativePath Condition="'$(LumyteParleyNativePath)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(LumyteParleyNativeOutput)/lumyte_text_parley.dll</LumyteParleyNativePath>
    <LumyteParleyNativePath Condition="'$(LumyteParleyNativePath)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(LumyteParleyNativeOutput)/liblumyte_text_parley.dylib</LumyteParleyNativePath>
    <LumyteParleyNativePath Condition="'$(LumyteParleyNativePath)' == ''">$(LumyteParleyNativeOutput)/liblumyte_text_parley.so</LumyteParleyNativePath>
    <LumyteParleyRustNoticesPath Condition="'$(LumyteParleyRustNoticesPath)' == ''">$(LumyteParleyNativeOutput)/RUST-STANDARD-LIBRARY-NOTICES.html</LumyteParleyRustNoticesPath>
    <LumyteParleyPackageRoot Condition="'$(LumyteParleyPackageRoot)' == ''">$(_LumyteParleyRepositoryRoot)artifacts/text-parley/package</LumyteParleyPackageRoot>
    <LumyteParleyHostRid Condition="'$(LumyteParleyHostRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</LumyteParleyHostRid>
    <LumyteParleyPackageRid Condition="'$(LumyteParleyPackageRid)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</LumyteParleyPackageRid>
    <LumyteParleyPackageRid Condition="'$(LumyteParleyPackageRid)' == ''">$(LumyteParleyHostRid)</LumyteParleyPackageRid>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'browser-wasm' and '$(LumyteParleyBrowser)' != 'true'">
    <None Include="$(LumyteParleyNativePath)" Link="$([System.IO.Path]::GetFileName('$(LumyteParleyNativePath)'))" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(LumyteParleyRustNoticesPath)" Link="RUST-STANDARD-LIBRARY-NOTICES.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="BuildLumyteParleyNative" BeforeTargets="BeforeBuild" DependsOnTargets="_PrepareLumyteBuildInvocation" Condition="'$(LumyteBuildParleyNative)' == 'true' and '$(RuntimeIdentifier)' != 'browser-wasm' and '$(LumyteParleyBrowser)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifier)' != '$(LumyteParleyHostRid)'" Text="Parley source builds target the current SDK host $(LumyteParleyHostRid), not $(RuntimeIdentifier). Supply a tested library for that runtime and set LumyteBuildParleyNative=false." />
    <Exec Command="$(_LumyteParleyBuildCommand) --target ParleyNative --root &quot;$(_LumyteParleyInvocationRoot).&quot; --repository-root &quot;$(_LumyteParleyRepositoryRoot).&quot; --output &quot;$([MSBuild]::EnsureTrailingSlash('$(LumyteParleyNativeOutput)')).&quot; --toolchain &quot;$(LumyteParleyNativeToolchain)&quot;" WorkingDirectory="$(_LumyteParleyRepositoryRoot)" />
  </Target>
  <Target Name="StageLumyteParleyNativePackage" AfterTargets="BuildLumyteParleyNative" Condition="'$(DesignTimeBuild)' != 'true' and '$(RuntimeIdentifier)' != 'browser-wasm' and '$(LumyteParleyBrowser)' != 'true' and Exists('$(LumyteParleyNativePath)')">
    <Error Condition="'$(LumyteParleyPackageRid)' == ''" Text="The target runtime for Parley packaging was not identified." />
    <Copy SourceFiles="$(LumyteParleyNativePath);$(LumyteParleyRustNoticesPath)" DestinationFolder="$(LumyteParleyPackageRoot)/runtimes/$(LumyteParleyPackageRid)/native" SkipUnchangedFiles="true" />
  </Target>
</Project>
