<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <Description>Repository build, verification, packaging and native tool orchestration.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Bootstrap/**/*.cs" />
    <PackageReference Include="Fallout.Build" Version="10.4.0" PrivateAssets="all" />
    <!-- Keep patched cryptography packages while Fallout's transitive baseline is older. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" PrivateAssets="all" />
    <EmbeddedResource Include="PythonRuntimes.json" LogicalName="Lumyte.Build.PythonRuntimes.json" />
    <EmbeddedResource Include="RustBootstrap.json" LogicalName="Lumyte.Build.RustBootstrap.json" />
  </ItemGroup>
</Project>
