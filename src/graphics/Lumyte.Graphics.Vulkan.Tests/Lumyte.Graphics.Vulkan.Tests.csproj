<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Native fixtures are compiled offline for the descriptor-heap ABI, separately from legacy packages. -->
    <EnableDefaultSlangCompileItems>false</EnableDefaultSlangCompileItems>
  </PropertyGroup>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lumyte.Graphics.Vulkan\Lumyte.Graphics.Vulkan.csproj" />
    <ProjectReference Include="..\Lumyte.Graphics.Native.Shaders\Lumyte.Graphics.Native.Shaders.csproj" />
    <ProjectReference Include="..\Lumyte.Graphics.Text\Lumyte.Graphics.Text.csproj" />
    <ProjectReference Include="..\Lumyte.Graphics.TwoD\Lumyte.Graphics.TwoD.csproj" />
    <ProjectReference Include="..\Lumyte.Graphics.Shader\Lumyte.Graphics.Shader.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.Shaderc" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <EmbeddedResource Include="Integration\Shaders\*.spv" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Lumyte.Graphics.Tests\GpuRenderGraphBackendConformanceTests.cs" Link="GpuRenderGraphBackendConformanceTests.cs" />
    <Compile Include="..\Lumyte.Graphics.Tests\GpuBackendTestGate.cs" Link="GpuBackendTestGate.cs" />
    <Compile Include="..\Lumyte.Graphics.Text.Tests\TextBackendConformanceTests.cs" Link="TextBackendConformanceTests.cs" />
    <Compile Include="..\Lumyte.Graphics.Text.Tests\TestFontData.cs" Link="TestFontData.cs" />
    <Compile Include="..\Lumyte.Graphics.TwoD.Tests\BackendConformanceTests.cs" Link="BackendConformanceTests.cs" />
    <Compile Include="..\..\..\samples\graphics\Lumyte.Graphics.Vulkan.Samples\SampleShaders.cs" Link="SampleShaders.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lumyte.Graphics.Library\Lumyte.Graphics.Library.csproj" />
    <SlangCompile Include="..\Lumyte.Graphics.Tests\Shaders\InputRaster.slang" />
    <SlangCompile Include="..\Lumyte.Graphics.Tests\Shaders\InputCompute.slang" />
  </ItemGroup>
  <Import Project="..\..\..\tools\Lumyte.Graphics.Shader.Offline\Lumyte.Graphics.Shader.Offline.targets" />
</Project>
