<div class="settings-node" data-path="@Node.Path" data-kind="@Node.Kind.ToString().ToLowerInvariant()">
    @if (Node.IsContainer)
    {
        <details open>
            <summary><span class="settings-key">@Node.Name</span><span class="settings-kind">@(Node.Kind == JsonValueKind.Array ? $"Array ({Node.Children.Count})" : $"Object ({Node.Children.Count})")</span></summary>
            <div class="settings-children">
                @foreach (SettingsTreeModel child in Node.Children)
                {
                    <SettingsTreeNode @key="child.Path" Node="child" />
                }
            </div>
        </details>
    }
    else
    {
        <div class="settings-leaf">
            <label for="@InputId"><span class="settings-key">@Node.Name</span><span class="settings-kind">@KindName</span></label>
            @if (Node.Kind is JsonValueKind.True or JsonValueKind.False)
            {
                <select id="@InputId" data-setting-path="@Node.Path" @bind="Node.Value"><option value="true">true</option><option value="false">false</option></select>
            }
            else if (Node.Kind == JsonValueKind.Null)
            {
                <span class="settings-null">null</span>
            }
            else
            {
                <input id="@InputId" data-setting-path="@Node.Path" type="@(Node.Kind == JsonValueKind.Number ? "number" : "text")" step="any" @bind="Node.Value" />
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public SettingsTreeModel Node { get; set; } = default!;

    private string InputId => "setting-" + Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(Node.Path)))[..12].ToLowerInvariant();

    private string KindName => Node.Kind switch
    {
        JsonValueKind.String => "String",
        JsonValueKind.Number => "Number",
        JsonValueKind.True or JsonValueKind.False => "Boolean",
        _ => "Null",
    };
}
