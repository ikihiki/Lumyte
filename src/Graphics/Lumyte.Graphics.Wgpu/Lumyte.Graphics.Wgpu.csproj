<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Graphics Wgpu device capabilities.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Lumyte.Graphics.Shared" />
    <ProjectReference Include="../Lumyte.Graphics.Shared/Lumyte.Graphics.Shared.csproj" />
    <ProjectReference Include="../Lumyte.Graphics.Abstractions/Lumyte.Graphics.Abstractions.csproj" />
    <PackageReference Include="Ahjo.Wgpu" Version="0.7.0" ExcludeAssets="native" PrivateAssets="native" />
    <PackageReference Include="Ahjo.Wgpu.Native" Version="0.7.0" ExcludeAssets="native" PrivateAssets="native" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Import Project="../../../build/Targets/WgpuNative.targets" />
</Project>
