<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../Lumyte.Platform.Browser/Lumyte.Platform.Browser.csproj" />
    <ProjectReference Include="../Lumyte.Platform.TextInput.Abstractions/Lumyte.Platform.TextInput.Abstractions.csproj" />
    <Content Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" Pack="true" PackageCopyToOutput="true" PackagePath="contentFiles/any/net10.0/wwwroot/" />
  </ItemGroup>
</Project>
