    <ProjectReference Include="../../src/Graphics/Lumyte.Graphics.Vulkan/Lumyte.Graphics.Vulkan.csproj" />
    <ProjectReference Include="../../src/Graphics/Lumyte.Graphics.Generators/Lumyte.Graphics.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
    <SlangShader Include="Shaders/vertex.slang" ResourceName="Lumyte.Gltf.vertex" Stage="vertex" />
