<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Build artifacts carry one explicit package root, never machine-specific
       Visual Studio/user fallback folders. Producers restore against this policy. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="lumyte-local" value="artifacts/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
