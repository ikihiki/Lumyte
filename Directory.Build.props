<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestoreTreatWarningsAsErrors>true</RestoreTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" />
  </ItemGroup>
  <!-- Consumers may evaluate metadata and compile isolated fixtures, never the
       checkout's canonical product projects. This also covers nested dotnet. -->
  <!-- MSBuildWorkspace evaluates CoreCompile with both switches to collect
       compiler arguments; the Csc task must not execute a compiler. -->
  <Target Name="RejectPrebuiltProductCompilation" BeforeTargets="CoreCompile"
          Condition="'$(LUMYTE_PREBUILT_CONSUMER)' == '1' and ($([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)src')) or $([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)samples')) or $([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)tests')) or $([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)benchmarks')) or '$(MSBuildProjectDirectory)' == '$([MSBuild]::NormalizePath($(MSBuildThisFileDirectory), tools, shaders, Lumyte.ShaderCompiler))' or '$(MSBuildProjectDirectory)' == '$(MSBuildThisFileDirectory)build') and ('$(DesignTimeBuild)' != 'true' or '$(SkipCompilerExecution)' != 'true')">
    <Error Text="Prebuilt consumer attempted product compilation or restoration: $(MSBuildProjectFullPath)" />
  </Target>
  <Target Name="RejectPrebuiltProductPreparation" BeforeTargets="Restore;BuildLumyteParleyNative;BuildLumyteWgpuNative;BuildLumyteUsvgNative;BuildLumyteDirect3D12Native;BuildLumyteParleyWasm"
          Condition="'$(LUMYTE_PREBUILT_CONSUMER)' == '1' and ($([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)src')) or $([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)samples')) or $([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)tests')) or $([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)benchmarks')) or '$(MSBuildProjectDirectory)' == '$([MSBuild]::NormalizePath($(MSBuildThisFileDirectory), tools, shaders, Lumyte.ShaderCompiler))' or '$(MSBuildProjectDirectory)' == '$(MSBuildThisFileDirectory)build')">
    <Error Text="Prebuilt consumer attempted product restoration or native source build: $(MSBuildProjectFullPath)" />
  </Target>
  <!-- BeforeTargets run even when the destination target's Condition skips it.
       Guard only real shader compilation, not the NoBuild packaging hook. -->
  <Target Name="RejectPrebuiltShaderCompilation" BeforeTargets="CompileSlangShaders"
          Condition="'$(LUMYTE_PREBUILT_CONSUMER)' == '1' and ($([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)src')) or $([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)samples')) or $([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)tests')) or $([System.String]::Copy('$(MSBuildProjectDirectory)').StartsWith('$(MSBuildThisFileDirectory)benchmarks')) or '$(MSBuildProjectDirectory)' == '$([MSBuild]::NormalizePath($(MSBuildThisFileDirectory), tools, shaders, Lumyte.ShaderCompiler))' or '$(MSBuildProjectDirectory)' == '$(MSBuildThisFileDirectory)build') and '@(SlangShader)' != '' and '$(NoBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Text="Prebuilt consumer attempted canonical shader compilation: $(MSBuildProjectFullPath)" />
  </Target>
</Project>
