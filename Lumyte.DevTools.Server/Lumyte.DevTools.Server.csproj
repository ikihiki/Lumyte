<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><Description>Browser and MagicOnion server for Lumyte development tools.</Description></PropertyGroup>
    <PropertyGroup><ClientAppDir>$(MSBuildProjectDirectory)\ClientApp</ClientAppDir></PropertyGroup>
  <ItemGroup><ProjectReference Include="../Lumyte.DevTools/Lumyte.DevTools.csproj" /><ProjectReference Include="../Lumyte.DevTools.Agent/Lumyte.DevTools.Agent.csproj" /><PackageReference Include="MagicOnion.Server" /></ItemGroup>
  <ItemGroup><FrontendSource Include="$(ClientAppDir)\src\**\*;$(ClientAppDir)\index.html;$(ClientAppDir)\vite.config.ts;$(ClientAppDir)\tsconfig*.json" /></ItemGroup>
  <Target Name="RestoreFrontend" BeforeTargets="BuildFrontend" Inputs="$(ClientAppDir)\package-lock.json" Outputs="$(ClientAppDir)\node_modules\.package-lock.json">
    <Exec WorkingDirectory="$(ClientAppDir)" Command="npm ci --ignore-scripts" />
  </Target>
  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild" DependsOnTargets="RestoreFrontend" Inputs="@(FrontendSource);$(ClientAppDir)\package-lock.json" Outputs="$(MSBuildProjectDirectory)\wwwroot\index.html">
    <Exec WorkingDirectory="$(ClientAppDir)" Command="npm run build" />
  </Target>
</Project>
