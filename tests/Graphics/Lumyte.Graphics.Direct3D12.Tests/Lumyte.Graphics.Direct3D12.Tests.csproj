<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../build/Targets/AgilitySdk.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <_TestWarpArch Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">x64</_TestWarpArch>
    <_TestWarpArch Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">arm64</_TestWarpArch>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../samples/Lumyte.Graphics.Shared/Lumyte.Graphics.Shared.csproj" />
    <AssemblyMetadata Include="AgilitySdkVersion" Value="$(LumyteAgilitySdkVersion)" />
    <ProjectReference Include="../../../src/Graphics/Lumyte.Graphics.Direct3D12/Lumyte.Graphics.Direct3D12.csproj" />
    <ProjectReference Include="../../../src/Graphics/Lumyte.Graphics.Shaders/Lumyte.Graphics.Shaders.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Microsoft.Direct3D.WARP" Version="1.0.22" GeneratePathProperty="true" IncludeAssets="none" PrivateAssets="all" />
    <None Include="$(PkgMicrosoft_Direct3D_WARP)/build/native/bin/$(_TestWarpArch)/d3d10warp.dll" Link="d3d10warp.dll" CopyToOutputDirectory="Always" />
    <None Include="$(PkgMicrosoft_Direct3D_WARP)/LICENSE.TXT" Link="WARP/LICENSE.TXT" CopyToOutputDirectory="Always" />
  </ItemGroup>
</Project>
