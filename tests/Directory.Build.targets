<Project>
  <!-- Keep the existing xUnit v2 discovery, theory and fixture protocols. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Lumyte.TestProjectPath</_Parameter1>
      <_Parameter2>$(MSBuildProjectFullPath)</_Parameter2>
    </AssemblyAttribute>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/LaneInventoryDiscoverer.cs" Link="Testing/LaneInventoryDiscoverer.cs" />
    <AssemblyAttribute Include="Xunit.TestFrameworkAttribute">
      <_Parameter1>Lumyte.Testing.CpuMethodTestFramework</_Parameter1>
      <_Parameter2>$(AssemblyName)</_Parameter2>
    </AssemblyAttribute>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/CpuMethodTestFramework.cs" Link="Testing/CpuMethodTestFramework.cs" />
  </ItemGroup>
  <!-- Lane properties remain local to each project; never pass one global VSTest filter. -->
  <Import Project="$(LumyteTestLaneTargets)" Condition="'$(LumyteTestLaneTargets)' != ''" />
</Project>
