<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Lumyte.Setup.Smoke.Native</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <Description>Development environment smoke test; not an engine package.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SelfContained>false</SelfContained>
    <IsWindowsRuntime Condition="'$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64'">true</IsWindowsRuntime>
    <NativeFileName Condition="'$(IsWindowsRuntime)' != 'true'">liblumyte_setup_smoke.so</NativeFileName>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../build/$(NativeFileName)" Condition="'$(IsWindowsRuntime)' != 'true'" Pack="true"
          PackagePath="runtimes/$(RuntimeIdentifier)/native/" />
    <None Include="../build/*.dll" Condition="'$(IsWindowsRuntime)' == 'true'" Pack="true"
          PackagePath="runtimes/$(RuntimeIdentifier)/native/" />
  </ItemGroup>
</Project>
