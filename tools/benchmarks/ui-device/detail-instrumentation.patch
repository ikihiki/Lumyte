diff --git a/src/Graphics/Lumyte.Graphics.Abstractions/UiDeviceProbe.cs b/src/Graphics/Lumyte.Graphics.Abstractions/UiDeviceProbe.cs
new file mode 100644
index 00000000..09f9eff3
--- /dev/null
+++ b/src/Graphics/Lumyte.Graphics.Abstractions/UiDeviceProbe.cs
@@ -0,0 +1,46 @@
+using System.Diagnostics;
+
+namespace Lumyte.Graphics.Abstractions;
+
+/// <summary>Temporary benchmark instrumentation; distributed only as an optional patch.</summary>
+public static class UiDeviceProbe
+{
+    /// <summary>Gets or sets the synchronous span collector.</summary>
+    public static Action<string, long, long, long, int>? Completed { get; set; }
+
+    /// <summary>Begins a diagnostic span.</summary>
+    /// <param name="name">The stable phase name.</param>
+    /// <returns>A nonallocating scope.</returns>
+    public static Scope Measure(string name) => new(name);
+
+    /// <summary>Records how late a timer returned relative to its requested deadline.</summary>
+    /// <param name="started">The timestamp immediately before arming the timer.</param>
+    /// <param name="timeout">The requested relative delay.</param>
+    public static void TimerReturned(long started, TimeSpan timeout)
+        => Completed?.Invoke("owner.timer-lateness", started + (long)(timeout.TotalSeconds * Stopwatch.Frequency), Stopwatch.GetTimestamp(), 0, Environment.CurrentManagedThreadId);
+
+    /// <summary>Measures inclusive wall time and same-thread allocations.</summary>
+    public readonly struct Scope : IDisposable
+    {
+        private readonly string _name;
+        private readonly long _started;
+        private readonly long _bytes;
+        private readonly int _thread;
+
+        internal Scope(string name)
+        {
+            _name = name;
+            _thread = Environment.CurrentManagedThreadId;
+            _bytes = GC.GetAllocatedBytesForCurrentThread();
+            _started = Stopwatch.GetTimestamp();
+        }
+
+        /// <summary>Reports the completed span; -1 allocation means the thread changed.</summary>
+        public void Dispose()
+        {
+            long ended = Stopwatch.GetTimestamp();
+            long bytes = _thread == Environment.CurrentManagedThreadId ? GC.GetAllocatedBytesForCurrentThread() - _bytes : -1;
+            Completed?.Invoke(_name, _started, ended, bytes, _thread);
+        }
+    }
+}
